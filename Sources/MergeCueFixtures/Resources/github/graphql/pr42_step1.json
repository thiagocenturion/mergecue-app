                    "createdAt": "2026-09-18T09:00:00Z",
                    "updatedAt": "2026-09-18T09:00:00Z",
                    "diffHunk": "@@ -80,7 +80,9 @@ final class ChargeService {\n     func charge(_ request: ChargeRequest) async throws -> Receipt {\n-        let response = try await gateway.post(request)\n+        let response = try await gateway.post(request, retries: 3)\n+        log.info(\"charged \\(request.cardNumber)\")\n         return Receipt(response)",
                    "outdated": false,
                    "author": {
                      "__typename": "User",
                      "login": "carol-reviews",
                      "avatarUrl": "https://avatars.githubusercontent.com/u/700101?v=4",
                      "databaseId": 700101,
